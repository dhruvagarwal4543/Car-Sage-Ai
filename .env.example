# Copy to .env and fill in. Placeholders only: never commit real values.
APP_ENV=development

# --- PostgreSQL (Neon is the primary database) ---------------------------------------------
# App / importer: Neon POOLED connection string (host contains "-pooler"). SSL is enforced for *.neon.tech.
DATABASE_URL=postgresql://NEON_USER:CHANGE_ME@ep-your-endpoint-pooler.REGION.aws.neon.tech/NEON_DB?sslmode=require
# Alembic migrations: Neon DIRECT (unpooled) connection string. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://NEON_USER:CHANGE_ME@ep-your-endpoint.REGION.aws.neon.tech/NEON_DB?sslmode=require
# PostgreSQL tests only: a SEPARATE database/branch whose name is exactly "carsage_test" (tests refuse any other name)
TEST_DATABASE_URL=postgresql+psycopg://CARSAGE_USER:CHANGE_ME@localhost:5432/carsage_test
# (local development without Neon works too: postgresql+psycopg://CARSAGE_USER:CHANGE_ME@localhost:5432/carsage)

# --- API ---------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# Optional path to the trained price model (default models/price_model.joblib)
PRICE_MODEL_PATH=

# --- Firebase Authentication (server side: verifies ID tokens; the service-account file stays OUT of the repo) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_FILE=/absolute/path/outside/the/repo/service-account.json

# Reserved for later phases
SECRET_KEY=CHANGE_ME_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
