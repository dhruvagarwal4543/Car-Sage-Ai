# Public Firebase WEB config (from Firebase console > Project settings > Your apps). Not secrets, but keep your own values out of git.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
# Only needed when the API is on another origin than the website (production). Leave empty in development (Vite proxies /api).
VITE_API_BASE_URL=
